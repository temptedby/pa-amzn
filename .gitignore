# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/data

# Playwright session profile + recon artifacts (contain cookies/PII)
.pw-profile/
scripts/pw-*.png

.pw-ads-onboard/
.pw-sc-profile/
.pw-*/

# Bear agent working data (track charter.md + backlog.md; ignore stores)
.agent/memory.jsonl
.agent/PROJECT-DIGEST.md
.agent/questions-for-William.md

# Legal/identity docs - never commit (may contain payment/PII)
.docs/

# Seller Central status reads — account PII, never commit
.sc-status/

# Creative sources pulled from Drive (203MB of originals). Drive is the master copy;
# these are a working cache and must never be committed.
/assets/source/
/build/creative/
